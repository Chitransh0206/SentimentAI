# Optional settings. SentimentAI does NOT auto-load this file (no python-dotenv).
# Set them in PowerShell before running, e.g.:   $env:SENTIMENTAI_MAX_UPLOAD_MB = "10"
SENTIMENTAI_DATASET=data/processed/reviews.csv
SENTIMENTAI_MAX_TEXT_CHARS=5000
SENTIMENTAI_MAX_UPLOAD_MB=25
SENTIMENTAI_MAX_BATCH_ROWS=100000
# Redirect model/metrics output to another root folder (used by the tests)
# SENTIMENTAI_ARTIFACT_ROOT=C:\path\to\folder
